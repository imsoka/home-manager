diff --git a/core/Launch.qml b/core/Launch.qml
new file mode 100644
index 0000000..cc75c1b
--- /dev/null
+++ b/core/Launch.qml
@@ -0,0 +1,18 @@
+pragma Singleton
+import QtQuick 2.15
+
+// What the A button does to a game. pegasus-library tags the games that are
+// owned but not installed with x-installed: no; launching those installs them.
+QtObject {
+    function installed(game) {
+        if (!game)
+            return true;
+        return game.extra["installed"] === undefined || game.extra["installed"][0] !== "no";
+    }
+
+    function label(game) {
+        if (!installed(game))
+            return "Install";
+        return game && game.playTime > 0 ? "Continue" : "Play";
+    }
+}

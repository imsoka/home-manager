diff --git a/core/Uninstall.qml b/core/Uninstall.qml
new file mode 100644
index 0000000..3360077
--- /dev/null
+++ b/core/Uninstall.qml
@@ -0,0 +1,93 @@
+pragma Singleton
+import QtQuick 2.15
+
+// Uninstalling from the detail page. A theme cannot run commands, so the
+// request is a file that a systemd .path unit hands to pegasus-uninstall,
+// which leaves the outcome in a status file polled from here. A singleton, so
+// an uninstall keeps being followed after its detail page unloads.
+QtObject {
+    id: root
+
+    readonly property string stateDir: "@stateDir@"
+
+    // key -> "running" | "ok" | "error", for as long as Pegasus stays up:
+    // its game list only catches up on the next start.
+    property var states: ({})
+
+    // pegasus-library sets x-uninstall on the installed games it can remove.
+    function key(game) {
+        if (!game || game.extra["uninstall"] === undefined
+                || game.extra["source"] === undefined || game.extra["id"] === undefined)
+            return "";
+        return game.extra["source"][0] + "-"
+            + String(game.extra["id"][0]).replace(/[^A-Za-z0-9._-]/g, "_");
+    }
+
+    function stateOf(game) {
+        var k = key(game);
+        return k !== "" && states[k] !== undefined ? states[k] : "";
+    }
+
+    function available(game) {
+        var s = stateOf(game);
+        return key(game) !== "" && (s === "" || s === "error");
+    }
+
+    function setState(k, s) {
+        var next = Object.assign({}, states);
+        next[k] = s;
+        states = next;
+    }
+
+    function put(url, body, done) {
+        var xhr = new XMLHttpRequest();
+        xhr.onreadystatechange = function() {
+            if (xhr.readyState === XMLHttpRequest.DONE && done)
+                done();
+        };
+        xhr.open("PUT", url);
+        xhr.send(body);
+    }
+
+    function request(game) {
+        var k = key(game);
+        if (k === "")
+            return;
+        setState(k, "running");
+        var base = "file://" + stateDir;
+        // A status left by an earlier try would read as this one's outcome.
+        put(base + "/status/" + k, "", function() {
+            put(base + "/queue/" + k, game.extra["source"][0] + "\n" + game.extra["id"][0] + "\n");
+        });
+        poll.start();
+    }
+
+    readonly property Timer poll: Timer {
+        interval: 1000
+        repeat: true
+        onTriggered: {
+            var pending = false;
+            for (var k in root.states) {
+                if (root.states[k] !== "running")
+                    continue;
+                pending = true;
+                root.check(k);
+            }
+            if (!pending)
+                stop();
+        }
+    }
+
+    function check(k) {
+        var xhr = new XMLHttpRequest();
+        xhr.onreadystatechange = function() {
+            if (xhr.readyState !== XMLHttpRequest.DONE)
+                return;
+            var s = xhr.responseText.trim();
+            if (s === "ok" || s === "error")
+                root.setState(k, s);
+        };
+        xhr.open("GET", "file://" + stateDir + "/status/" + k);
+        xhr.send();
+    }
+}

+FingerprintState PolkitAgent::fingerprintState() const {
+  if (m_impl == nullptr || !m_impl->sawFingerprint) {
+    return FingerprintState::Hidden;
+  }
+  if (m_impl->fingerprintSuccess) {
+    return FingerprintState::Success;
+  }
+  if (m_impl->supplementaryFingerprint && m_impl->supplementaryError) {
+    return FingerprintState::Error;
+  }
+  return FingerprintState::Scanning;
+}

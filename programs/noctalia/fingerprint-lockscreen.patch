+#pragma once
+
+#include <cstdint>
+
+// Estado del icono de huella en la pantalla de bloqueo y en el popup de polkit.
+enum class FingerprintState : std::uint8_t {
+  Hidden,
+  Scanning,
+  Error,
+  Success,
+};

input {
    keyboard {
        xkb {
            layout "es"
        }
        numlock
    }

    touchpad {
        tap
        natural-scroll
    }

    // Pulsar el workspace activo vuelve al anterior (como i3).
    workspace-auto-back-and-forth
}

layout {
    gaps 8

    // Solo un borde de 1 px en la ventana enfocada; el focus-ring por defecto
    // (4 px) se sumaba al borde y quedaba muy grueso
    focus-ring {
        off
    }

    border {
        width 1
        active-color "#8aadf4cc"
        inactive-color "#00000000"
    }
}

prefer-no-csd

screenshot-path "~/Pictures/Screenshots/%Y-%m-%d_%H-%M-%S.png"

spawn-at-startup "noctalia" "-d"
spawn-at-startup "sh" "-c" "wl-paste --type text --watch cliphist store"
spawn-at-startup "sh" "-c" "wl-paste --type image --watch cliphist store"
// Carga los presets de Input Remapper marcados como autoload (macro del
// G305). Le pasa al servicio la carpeta de config del usuario, que luego usan
// las reglas udev al reconectar el ratón; niri no lanza el .desktop de autostart
spawn-at-startup "input-remapper-control" "--command" "autoload"

// La ventana de ajustes de Noctalia flota en vez de abrirse como columna
window-rule {
    match app-id=r#"^dev\.noctalia\.Noctalia$"#
    open-floating true
}

// KeePassXC flota (app-id "org.keepassxc.KeePassXC" en Wayland, "keepassxc" vía X11)
window-rule {
    match app-id=r#"(?i)keepassxc"#
    open-floating true
}

// Juegos de Steam vía Proton (XWayland: WM_CLASS steam_app_<id>) flotan y
// no se abren a pantalla completa aunque la pidan (los de gamescope no la
// piden, ver steam-gamescope). El servicio steam-game-workspace los lleva al
// workspace "game" a 1920x1080; Mod+F la pone a mano.
window-rule {
    match app-id=r#"^steam_app_"#
    open-floating true
    open-fullscreen false
}

// El DPS meter de AION 2 (A2Tools) flota, así queda encima del juego si se
// abre en su workspace. App-id "a2tools-dps-meter" en X11, en Wayland
// depende de Tauri
window-rule {
    match app-id=r#"(?i)a2tools"#
    open-floating true
}

// La ventana principal de Steam se abre maximizada (como Mod+M); el título
// deja fuera sus diálogos, que comparten app-id
window-rule {
    match app-id=r#"^steam$"# title=r#"^Steam$"#
    open-maximized true
}

// La lista de amigos de Steam flota
window-rule {
    match app-id=r#"^steam$"# title=r#"^(Lista de amigos|Friends List)$"#
    open-floating true
}

// Barra de dictado de Typeless (XWayland): overlay transparente que niri
// rellenaba con el color del borde, tapando la ventana de login. Sin borde ni
// fondo, sin robar el foco y abajo del todo para no tapar nada
window-rule {
    match app-id=r#"^Typeless-floating-bar$"#
    open-floating true
    open-focused false
    draw-border-with-background false
    focus-ring { off; }
    border { off; }
    shadow { off; }
    default-floating-position x=0 y=0 relative-to="bottom"
}

binds {
    Mod+Return { spawn "alacritty"; }
    Mod+D { spawn "noctalia" "msg" "panel-toggle" "launcher"; }
    Mod+Ctrl+L { spawn "noctalia" "msg" "session" "lock"; }
    Mod+Shift+Q { close-window; }
    Mod+Shift+E { quit; }
    Mod+Shift+Slash { show-hotkey-overlay; }

    Mod+H { focus-column-left; }
    Mod+J { focus-window-down; }
    Mod+K { focus-window-up; }
    Mod+L { focus-column-right; }

    Mod+Shift+H { move-column-left; }
    Mod+Shift+J { move-window-down; }
    Mod+Shift+K { move-window-up; }
    Mod+Shift+L { move-column-right; }

    // Apilar verticalmente: absorber la ventana de la derecha debajo / expulsar la de abajo
    Mod+Comma  { consume-window-into-column; }
    Mod+Period { expel-window-from-column; }

    Mod+M { maximize-column; }
    Mod+F { fullscreen-window; }
    Mod+Shift+F { fullscreen-window; }
    Mod+Space { toggle-window-floating; }

    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }

    Mod+Shift+1 { move-window-to-workspace 1; }
    Mod+Shift+2 { move-window-to-workspace 2; }
    Mod+Shift+3 { move-window-to-workspace 3; }
    Mod+Shift+4 { move-window-to-workspace 4; }
    Mod+Shift+5 { move-window-to-workspace 5; }
    Mod+Shift+6 { move-window-to-workspace 6; }
    Mod+Shift+7 { move-window-to-workspace 7; }
    Mod+Shift+8 { move-window-to-workspace 8; }
    Mod+Shift+9 { move-window-to-workspace 9; }

    Print { screenshot; }

    // ThinkPad P15s function keys (F1–F8). Fn-lock off = media keys.
    XF86AudioMute        allow-when-locked=true { spawn "noctalia" "msg" "volume-mute"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn "noctalia" "msg" "volume-down"; }
    XF86AudioRaiseVolume allow-when-locked=true { spawn "noctalia" "msg" "volume-up"; }
    XF86AudioMicMute     allow-when-locked=true { spawn "noctalia" "msg" "mic-mute"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "noctalia" "msg" "brightness-down"; }
    XF86MonBrightnessUp   allow-when-locked=true { spawn "noctalia" "msg" "brightness-up"; }
    XF86WLAN             { spawn "noctalia" "msg" "wifi-toggle"; }

    // Teams calls: pickup key accepts with audio (Ctrl+Shift+A), hangup key hangs up (Ctrl+Shift+H).
    XF86PickupPhone { spawn "wtype" "-M" "ctrl" "-M" "shift" "a" "-m" "shift" "-m" "ctrl"; }
    XF86HangupPhone { spawn "wtype" "-M" "ctrl" "-M" "shift" "h" "-m" "shift" "-m" "ctrl"; }

    // ThinkPad Teams key (sends XF86NotificationCenter) opens Teams
    XF86NotificationCenter { spawn "teams-for-linux"; }
}

// En pantalla completa niri manda el búfer del juego directo a la pantalla
// (direct scanout); con NVIDIA + XWayland eso daba artefactos en Aion 2
debug {
    disable-direct-scanout
}
